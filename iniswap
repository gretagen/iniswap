#!/bin/bash
set -euo pipefail

VALID_INITS="openrc runit dinit systemd"
LIMINE_CONF="/boot/limine.conf"
LIB_DIR="/usr/lib/nacelle/iniswap"

usage() {
    echo "Usage: iniswap [--pass] <init>"
    echo
    echo "Swap the init system on next boot."
    echo
    echo "Commands:"
    echo "  iniswap <init>    Swap to a different init system"
    echo "  iniswap --status  Show current init system"
    echo
    echo "Flags:"
    echo "  --pass            Skip confirmation prompt"
    echo "  -s, --status      Same as --status"
    echo "  -h, --help        Show this help"
    echo
    echo "Supported init systems:"
    echo "  openrc   OpenRC (default)"
    echo "  runit    runit"
    echo "  dinit    dinit"
    echo "  systemd  systemd"
}

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo "To swap your init system, you need superuser privileges." >&2
        exit 1
    fi
}

detect_current_init() {
    if [ ! -f "$LIMINE_CONF" ]; then
        echo "openrc"
        return
    fi

    # Only the first cmdline line (the default /Haliade SYS entry) declares
    # the active init — generation entries carry their own historical init=.
    local cmdline
    cmdline=$(grep -m1 '^[[:space:]]*cmdline:' "$LIMINE_CONF" 2>/dev/null || true)

    # Anchored: init= must start the line or follow whitespace so params
    # like "reinit=5" don't false-match.
    local init_path
    init_path=$(echo "$cmdline" | sed -n 's/.*[[:space:]]init=\([^ ]*\).*/\1/p')

    if [ -n "$init_path" ]; then
        case "$init_path" in
            */runit-init)   echo "runit" ;;
            */dinit)        echo "dinit" ;;
            */openrc-init)  echo "openrc" ;;
            */systemd)      echo "systemd" ;;
            *)              echo "unknown" ;;
        esac
    else
        echo "openrc"
    fi
}

validate_init() {
    local name="$1"
    for valid in $VALID_INITS; do
        if [ "$name" = "$valid" ]; then
            return 0
        fi
    done
    return 1
}

update_boot() {
    local init="$1"
    local tmp="$LIMINE_CONF.tmp"
    local init_param

    case "$init" in
        openrc) init_param="init=/sbin/openrc-init" ;;
        runit)  init_param="init=/sbin/runit-init" ;;
        dinit)  init_param="init=/sbin/dinit" ;;
        systemd) init_param="init=/sbin/systemd" ;;
        *)
            echo "Error: unsupported init '$init'." >&2
            return 1
            ;;
    esac

    # Patch ONLY the first cmdline line (the default /Haliade SYS entry).
    # Generation entries each record the init that was active when they were
    # created and must never be rewritten — a pre-swap generation has to boot
    # the *previous* init, not the target one.
    awk -v param="$init_param" '
        !done && /^[[:space:]]*cmdline:/ {
            line = $0
            # strip any existing init= token so re-runs never double it
            if (match(line, /[[:space:]]init=[^ ]*/)) {
                line = substr(line, 1, RSTART - 1) substr(line, RSTART + RLENGTH)
            }
            print line " " param
            done = 1
            next
        }
        { print }
    ' "$LIMINE_CONF" > "$tmp"

    mv "$tmp" "$LIMINE_CONF"
}
# record init identity
# The universal shutdown/reboot commands (/usr/bin/shutdown, /usr/bin/reboot)
# read /var/db/init/current and fall back to /var/db/init/previous: after a
# swap the target init is only declared, not yet PID1, so its own shutdown
# tool doesn't work until the next boot — which is exactly when the
# shutdown/reboot wrappers roll down to "previous" (the then-running init).
record_init_state() {
    local db="/var/db/init"
    mkdir -p "$db"
    # previous <- current (only if current already has state)
    if [ -s "$db/current" ]; then
        cat "$db/current" > "$db/previous"
    fi
    # current <- newly selected init
    printf '%s\n' "$target" > "$db/current"
}

# --- main ---

# Parse flags
SKIP_CONFIRM=false
if [ "${1:-}" = "--pass" ]; then
    SKIP_CONFIRM=true
    shift
fi

# Reading state is fine for any user; only the swap itself needs superuser
# privileges, so these run before the gate below.
if [ "${1:-}" = "--status" ] || [ "${1:-}" = "-s" ]; then
    current=$(detect_current_init)
    echo "Current init: $current"
    exit 0
fi

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    usage
    exit 0
fi

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

target="$1"

if ! validate_init "$target"; then
    echo "Error: unsupported init '$target'." >&2
    echo "Supported: $VALID_INITS" >&2
    exit 1
fi

# The swap rewrites the boot configuration and installs services: root only.
# It comes after validation so a bad argument still reports itself.
check_root

current=$(detect_current_init)

if [ "$current" = "$target" ]; then
    echo "Already running $target."
    exit 0
fi

echo "Swapping init: $current -> $target"
echo
if [ "$SKIP_CONFIRM" = false ]; then
    read -r -p "Swap init? [y/N] " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Cancelled."
        exit 0
    fi
fi
echo

# Create a pre-swap generation so we can always roll back
echo "Creating pre-swap generation..."
if ! chronos create "before swap to $target"; then
    echo "Warning: failed to create pre-swap generation." >&2
fi
echo

# Source init-specific handler
handler="$LIB_DIR/$target.sh"
if [ ! -f "$handler" ]; then
    echo "Error: handler not found: $handler" >&2
    exit 1
fi

# shellcheck source=/dev/null
. "$handler"

echo "Installing $target..."
install_"$target"

echo "Generating $target services..."
generate_"$target"_services

echo "Updating boot configuration..."
update_boot "$target"

echo "Recording init state..."
record_init_state

echo
echo "Init swapped: $current -> $target"
echo "Reboot to change to $target."
